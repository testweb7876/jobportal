# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
API_VERSION=v1
CLIENT_URL=http://localhost:3000
LOG_LEVEL=info
ENABLE_CRON=false

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/jobportal
MONGO_URI_PROD=mongodb+srv://<user>:<password>@cluster.mongodb.net/jobportal?retryWrites=true&w=majority

# ─── JWT & Cookies ────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRE=7d
COOKIE_SECRET=your_cookie_signing_secret_32chars
COOKIE_EXPIRES_DAYS=7

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── SMTP Email ───────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=your@gmail.com
EMAIL_FROM_NAME=JobPortal

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# ─── Security ─────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ─── File Sizes ───────────────────────────────────────────────────────────────
MAX_IMAGE_SIZE=5242880
MAX_FILE_SIZE=10485760

# ─── Optional ─────────────────────────────────────────────────────────────────
SENTRY_DSN=
OPENAI_API_KEY=
